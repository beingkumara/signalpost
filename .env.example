# All keys are optional. With none set the agent runs on free public sources only ($0).
# Website discovery via web search (candidates only; a site is published only with org-number proof).
# Providers are tried in this order until one answers; order can be changed with SIGNALPOST_SEARCH_PROVIDERS.
TAVILY_API_KEY=
EXA_API_KEY=
LINKUP_API_KEY=
FIRECRAWL_API_KEY=
SIGNALPOST_SEARCH_PROVIDERS=tavily,exa,linkup,firecrawl
SIGNALPOST_SEARCH_MAX=150

# Grounded English overviews (every sentence cites claims; unsupported numbers are rejected).
ANTHROPIC_API_KEY=
SIGNALPOST_LLM_MODEL=claude-haiku-4-5-20251001
SIGNALPOST_LLM_MAX_USD=1.0

# Run budgets
SIGNALPOST_REQUEST_BUDGET=
SIGNALPOST_MAX_MINUTES=30
